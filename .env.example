# InfraTrace - Environment Variables Configuration

# Supabase API Endpoint
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Secret Key (REQUIRED ONLY for scripts/seed.mjs, NEVER expose to browser or client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
